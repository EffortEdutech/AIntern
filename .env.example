# AIntern Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

VITE_SUPABASE_URL=https://wdhdjhvvngssnszqgiyk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

VITE_APP_ENV=development
VITE_APP_URL=http://localhost:4900

# Central Payment Hub integration
# Browser production auth uses the signed-in Supabase user access token.
# VITE_PAYMENT_HUB_APP_TOKEN is optional and must only be used for local sandbox/operator testing.
VITE_PAYMENT_HUB_BASE_URL=http://127.0.0.1:3017
VITE_PAYMENT_HUB_APP_ID=aintern
VITE_PAYMENT_HUB_APP_TOKEN=
VITE_PAYMENT_HUB_ENVIRONMENT=test